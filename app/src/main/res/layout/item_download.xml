<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke"
    app:strokeWidth="1dp">

    <!-- v0.19.8: a barra de progresso saiu da coluna do título (onde morria
         antes do % e dos botões — "fica pela metade", queixa do autor) e
         agora é um arquivo próprio na LARGURA INTEIRA do card, alinhada com
         o texto e com o botão de cancelar. Os ids continuam os mesmos: o
         adapter não mudou uma linha. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/on_background"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notif_action_pause"
                android:src="@drawable/ic_pause"
                android:visibility="gone"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_share"
                android:src="@drawable/ic_share"
                android:visibility="gone"
                app:tint="@color/primary" />

            <!-- v0.19.5: lixeira do card concluído — apaga a MÍDIA de verdade
                 (arquivo no aparelho), não só o card da lista -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lib_delete"
                android:src="@drawable/ic_delete"
                android:visibility="gone"
                app:tint="@color/state_failed" />

            <ImageButton
                android:id="@+id/btnCancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notif_action_cancel"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/state_failed" />

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_copy"
                android:src="@drawable/ic_copy"
                android:visibility="gone"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <!-- Largura inteira do card (v0.19.8): vai do padding esquerdo ao
             direito, acompanhando o texto e o botão de cancelar -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressBackgroundTint="@color/stroke"
            android:progressTint="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
