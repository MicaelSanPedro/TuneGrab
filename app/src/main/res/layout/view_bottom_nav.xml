<?xml version="1.0" encoding="utf-8"?>
<!-- Barra "empurra" (v0.19.3): a ExpandingNavBar cresce a aba clicada
     (ícone + nome lado a lado) e desliza os vizinhos pra fora do caminho.
     Mesmo ID bottomNav de sempre — o binding e o MainActivity não mudam. -->
<com.tunegrab.app.ui.ExpandingNavBar
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp" />
