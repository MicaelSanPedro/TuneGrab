<!-- Barra "empurra" (v0.19.3): a ExpandingNavBar cresce a aba clicada
     (ícone + nome lado a lado) e desliza os vizinhos pra fora do caminho.
     Mesmo ID bottomNav de sempre — o binding e o MainActivity não mudam.
     v0.19.6: ÍCONES FLUTUANTES (pedido do autor) — a caixa com borda e a
     pill roxa do item ativo saíram de cena: os glifos flutuam direto sobre
     o fundo do app, e o destaque da aba ativa é cor violeta + nome +
     escala do ícone. -->
<com.tunegrab.app.ui.ExpandingNavBar
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp" />
