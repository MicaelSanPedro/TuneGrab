<?xml version="1.0" encoding="utf-8"?>
<!-- LOGIN DO YOUTUBE (v0.18.6): WebView do youtube.com para o usuário
     logar na conta dele; o app captura os cookies do CookieManager e o
     yt-dlp recebe a sessão (opcao cookies) — o anti-bot para na origem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:text="@string/cookie_title"
        android:textColor="@color/on_background"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="@string/cookie_instructions"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvCookieState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/cookie_state_anon"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCookies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cookie_save"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/on_background" />
    </LinearLayout>
</LinearLayout>
