<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.tunegrab.app.video.FitVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Player HD (v0.17.0): reprodução DASH do play do Início — faixa de
         vídeo (até 1080p, video-only) + faixa de áudio separadas, MERGIDAS
         pelo ExoPlayer (Media3). O FitVideoView acima segue nos arquivos
         LOCAIS da Biblioteca (MediaPlayer). resize_mode=fit mantém o aspect
         ratio em qualquer tela/orientação; show_buffering gira o spinner -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- Controles de ÁUDIO — estilo minimalista da referência (v0.18.8):
         cartão de arte grande com cantos bem redondos, waveform fina do som
         REAL, progresso fino, botão de play circular CHEIO e slider de
         volume — tudo na paleta violeta/fúcsia do app -->
    <LinearLayout
        android:id="@+id/audioControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_album_art"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Barrinhas de DJ (v0.18.8): espectro REAL do áudio que está
             tocando — o SpectrumProcessor espia o PCM dentro do próprio
             player (SEM permissão nenhuma). Faixa fina, igual à referência -->
        <com.tunegrab.app.VisualizerView
            android:id="@+id/visualizer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:progressBackgroundTint="@color/stroke"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Play/PAUSE: disco circular cheio (estilo da referência), ícone
             escuro por cima do violeta -->
        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_play_circle"
            android:contentDescription="@string/player_play"
            android:padding="21dp"
            android:src="@drawable/ic_play"
            app:tint="@color/background" />

        <!-- Volume: alto-falante — slider — alto-falante grande (v0.18.8,
             controle REAL do STREAM_MUSIC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/player_volume"
                android:src="@drawable/ic_volume_low"
                app:tint="@color/on_surface_variant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="15"
                app:labelBehavior="gone"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="@color/stroke" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume_high"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Carregando stream remoto (reproduzir sem baixar): gira até o
         MediaPlayer preparar / termina a pausa de rede -->
    <ProgressBar
        android:id="@+id/progressBuffer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/player_buffering"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_close"
        android:src="@drawable/ic_back"
        app:tint="@color/on_background" />

    <!-- Tela cheia do VÍDEO: gira o app para paisagem (só aparece no vídeo) -->
    <ImageButton
        android:id="@+id/btnFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_fullscreen"
        android:src="@drawable/ic_fullscreen"
        android:visibility="gone"
        app:tint="@color/on_background" />
</FrameLayout>
