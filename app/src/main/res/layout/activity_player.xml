<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.tunegrab.app.video.FitVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Player HD (v0.17.0): reprodução DASH do play do Início — faixa de
         vídeo (até 1080p, video-only) + faixa de áudio separadas, MERGIDAS
         pelo ExoPlayer (Media3). O FitVideoView acima segue nos arquivos
         LOCAIS da Biblioteca (MediaPlayer). resize_mode=fit mantém o aspect
         ratio em qualquer tela/orientação; show_buffering gira o spinner -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="always"
        app:use_controller="true" />

    <!-- Controles de ÁUDIO — estilo minimalista da referência (v0.18.8):
         cartão de arte grande com cantos bem redondos, waveform fina do som
         REAL, progresso fino, botão de play circular CHEIO e slider de
         volume — tudo na paleta violeta/fúcsia do app -->
    <LinearLayout
        android:id="@+id/audioControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp">

            <!-- CAPA da música (v0.19.0): quando o arquivo tem capa embutida
                 (pedido do autor: áudios baixam com capa), o bitmap cobre o
                 cartão inteiro — clipToOutline usa o contorno arredondado do
                 bg_album_art. Sem capa: o gradiente violeta de sempre -->
            <ImageView
                android:id="@+id/imgArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_album_art"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgArtIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Barrinhas de DJ (v0.18.9): espectro REAL do áudio que está
             tocando — o SpectrumProcessor espia o PCM dentro do próprio
             player (SEM permissão nenhuma). Grave no centro, agudo nas
             pontas, espelhado e SEM emenda. Faixa alta: as barras sobem
             de verdade na pancada -->
        <com.tunegrab.app.VisualizerView
            android:id="@+id/visualizer"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:progressBackgroundTint="@color/stroke"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Transporte (v0.19.0): ANTERIOR — play — PRÓXIMA (pedido do
             autor). Os botões laterais conversam com a fila da Biblioteca
             que o PlaybackService guarda; sem fila, ficam apagados.
             O slider de volume saiu (pedido: "tira aquilo de áudio") -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:padding="14dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/on_background" />

            <!-- Play/PAUSE: disco circular cheio (estilo da referência), ícone
                 escuro por cima do violeta -->
            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/player_play"
                android:padding="21dp"
                android:src="@drawable/ic_play"
                app:tint="@color/background" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:padding="14dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/on_background" />
        </LinearLayout>
    </LinearLayout>

    <!-- Carregando stream remoto (reproduzir sem baixar): gira até o
         MediaPlayer preparar / termina a pausa de rede -->
    <ProgressBar
        android:id="@+id/progressBuffer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="@string/player_buffering"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_close"
        android:src="@drawable/ic_back"
        app:tint="@color/on_background" />

    <!-- Tela cheia do VÍDEO: gira o app para paisagem (só aparece no vídeo) -->
    <ImageButton
        android:id="@+id/btnFullscreen"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_fullscreen"
        android:src="@drawable/ic_fullscreen"
        android:visibility="gone"
        app:tint="@color/on_background" />
</FrameLayout>
