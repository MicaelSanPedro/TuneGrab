<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.9: Configurações estilo YouTube LITERAL (pedido do autor: "devem
     ser LITERALMENTE do jeito que está no YouTube, ou seja, como se fosse
     em pastas. Por exemplo: quando eu abrir o app, lá vai ter uma seção
     clicável só de configurações de áudio, e outra de vídeo, aí quando eu
     clicar, aparece as opções").

     Estrutura: lista principal com PASTAS clicáveis (ícone + título +
     subtítulo + seta) e a área de detalhe com as 8 páginas (um include
     por assunto, só um visível por vez). Voltar = botão do cabeçalho OU
     o back do sistema (OnBackPressedCallback no SettingsFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ══════ Cabeçalho RAIZ: título + subtítulo ══════ -->
    <LinearLayout
        android:id="@+id/headerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/on_background"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_sub"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ══════ Cabeçalho DETALHE: voltar + nome da página (gone na raiz) ══════ -->
    <LinearLayout
        android:id="@+id/headerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="24dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/on_background"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══════ LISTA PRINCIPAL: pastas clicáveis ══════ -->
    <ScrollView
        android:id="@+id/pageRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp">

            <!-- Pasta: DOWNLOADS -->
            <LinearLayout
                android:id="@+id/catDownloads"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_downloads" />

                    <TextView
                        android:id="@+id/tvCatDownloadsSub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_downloads" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: ÁUDIO -->
            <LinearLayout
                android:id="@+id/catAudio"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_note" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_audio" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_audio" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: VÍDEO -->
            <LinearLayout
                android:id="@+id/catVideo"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_movie" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_video" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_video" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: PLAYER -->
            <LinearLayout
                android:id="@+id/catPlayer"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_equalizer" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_player" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_player" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- REPRODUÇÃO AUTOMÁTICA (v0.19.17): na LISTA PRINCIPAL, sem
                 entrar em pasta (pedido do autor — fácil de achar). NÃO é
                 pasta: switch inline na própria linha, toque na linha
                 inteira alterna; o " ? " ao lado abre o diálogo explicando
                 o que a opção faz (pedido do autor — nada de adivinhar).
                 Ligada, a fila da Biblioteca recomeça do começo quando
                 acaba; desligada, para na última faixa -->
            <LinearLayout
                android:id="@+id/rowAutoplay"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_repeat" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_autoplay" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_autoplay" />
                </LinearLayout>

                <!-- " ? " (v0.19.17): ajuda da opção — clicável por conta
                     própria, então NÃO alterna o switch da linha -->
                <ImageButton
                    android:id="@+id/btnAutoplayHelp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/set_autoplay_help"
                    android:src="@drawable/ic_help"
                    app:tint="@color/on_surface_variant" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Pasta: YOUTUBE (subtítulo = status da conta, dinâmico) -->
            <LinearLayout
                android:id="@+id/catYoutube"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_youtube" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_youtube" />

                    <TextView
                        android:id="@+id/tvCatYoutubeSub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_account_off" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: AJUDA -->
            <LinearLayout
                android:id="@+id/catHelp"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_help" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_help" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: ATUALIZAÇÃO -->
            <LinearLayout
                android:id="@+id/catUpdate"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_update" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_update" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Pasta: SOBRE (sem GitHub — pedido do autor) -->
            <LinearLayout
                android:id="@+id/catAbout"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_cat_about" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_cat_about" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════ ÁREA DE DETALHE: a página do assunto (gone na raiz) —
         só UM include visível por vez (openCategory controla) ══════ -->
    <ScrollView
        android:id="@+id/pageDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp">

            <include
                android:id="@+id/pageDownloads"
                layout="@layout/page_downloads" />

            <include
                android:id="@+id/pageAudio"
                layout="@layout/page_audio" />

            <include
                android:id="@+id/pageVideo"
                layout="@layout/page_video" />

            <include
                android:id="@+id/pagePlayer"
                layout="@layout/page_player" />

            <include
                android:id="@+id/pageYoutube"
                layout="@layout/page_youtube" />

            <include
                android:id="@+id/pageHelp"
                layout="@layout/page_help" />

            <include
                android:id="@+id/pageUpdate"
                layout="@layout/page_update" />

            <include
                android:id="@+id/pageAbout"
                layout="@layout/page_about" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
