<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.8: Configurações organizadas POR CATEGORIA (pedido do autor:
     "deixa as configurações organizadas por categoria, tipo downloads,
     armazenamento… deixa parecido com a foto") — a foto era as
     configurações do YouTube: cabeçalho de categoria em negrito e linhas
     de ícone + título + subtítulo. A seção de cookies/manual saiu (o login
     agora é automático na aba YouTube) e as escolhas de qualidade viraram
     linhas que abrem diálogo, como "Idiomas" nas configs do YouTube. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:text="@string/settings_title"
                android:textColor="@color/on_background"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="14dp"
                android:text="@string/settings_sub"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <!-- ══════════════ CATEGORIA: DOWNLOADS ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_downloads" />

            <!-- Pasta de download: subtítulo = pasta atual; toque abre o SAF -->
            <LinearLayout
                android:id="@+id/rowFolder"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_folder" />

                    <TextView
                        android:id="@+id/tvFolderCurrent"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_folder_default" />
                </LinearLayout>
            </LinearLayout>

            <!-- Só aparece com pasta personalizada ativa -->
            <LinearLayout
                android:id="@+id/rowFolderReset"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reset_folder" />
                </LinearLayout>
            </LinearLayout>

            <!-- Qualidade do MP3: toque abre diálogo de escolha única -->
            <LinearLayout
                android:id="@+id/rowMp3"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music_note" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_mp3" />

                    <TextView
                        android:id="@+id/tvMp3Sub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Qualidade do M4A -->
            <LinearLayout
                android:id="@+id/rowM4a"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_library_music" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_m4a" />

                    <TextView
                        android:id="@+id/tvM4aSub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Qualidade dos vídeos -->
            <LinearLayout
                android:id="@+id/rowVideo"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_movie" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_video" />

                    <TextView
                        android:id="@+id/tvVideoSub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════ CATEGORIA: PLAYER ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_player" />

            <!-- Barrinhas de áudio: switch inline na própria linha -->
            <LinearLayout
                android:id="@+id/rowVisualizer"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_equalizer" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_visualizer" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_visualizer" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swVisualizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- ══════════════ CATEGORIA: YOUTUBE ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_youtube" />

            <!-- Conta do YouTube (v0.19.8): o login acontece DENTRO da aba
                 YouTube e é detectado sozinho — daqui o usuário só VÊ o
                 status (e desconecta, se quiser). Nada de cookies.txt. -->
            <LinearLayout
                android:id="@+id/rowAccount"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_youtube" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_account" />

                    <TextView
                        android:id="@+id/tvAccountSub"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════ CATEGORIA: AJUDA ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_help" />

            <LinearLayout
                android:id="@+id/rowTutorial"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tutorial_btn" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_tutorial_hint" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════ CATEGORIA: ATUALIZAÇÃO ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_update" />

            <LinearLayout
                android:id="@+id/rowUpdate"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/update_check_btn" />

                    <TextView
                        android:id="@+id/tvUpdateStatus"
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_update" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════ CATEGORIA: SOBRE ══════════════ -->
            <TextView
                style="@style/SettingsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_cat_about" />

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:textColor="@color/on_background"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="2dp"
                android:text="@string/about_engines"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/rowGithub"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/SettingsRowIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_github" />

                <LinearLayout
                    style="@style/SettingsRowTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_row_github" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_sub_github" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
