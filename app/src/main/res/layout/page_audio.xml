<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.10: página "Áudio" com as opções VISÍVEIS na tela (pedido:
     "só aparece o que cada config faz" — acabou). Igual às configs do
     YouTube de verdade: linha com título + sub + bolinha de seleção,
     toque escolhe na hora e salva — SEM diálogo, SEM explain-text.
     As linhas antigas que abriam diálogo (rowMp3/rowM4a) saíram. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_row_mp3" />

    <!-- 320 kbps -->
    <LinearLayout
        android:id="@+id/rowMp3320"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_mp3_320" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_sub_320" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rMp3320"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 256 kbps -->
    <LinearLayout
        android:id="@+id/rowMp3256"
