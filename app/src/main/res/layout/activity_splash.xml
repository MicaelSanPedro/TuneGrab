<?xml version="1.0" encoding="utf-8"?>
<!-- Loader de abertura: logo e "bem-vindo" na Aston Script (fonte do próprio
     autor do app). Desde a v0.18.8 a VERSÃO fica no rodapé da tela (pedido
     do autor) e a assinatura "feito por micaelsan" mudou pro rodapé do
     Início, ao lado do número da versão. O "bem-vindo" tem ALTURA FIXA: o
     autoSize com wrap_content deixava a view mais baixa que a própria linha
     da fonte (a Aston Script tem caixa de linha de 2,175em) e o Android
     cortava metade do texto — com altura fixa o autoSize só escolhe o
     tamanho pela largura e a caixa nunca aperta. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <!-- autoSize pela LARGURA + altura FIXA de 124dp (caixa cheia do tamanho
             máximo, 56sp × 2,175em = 122dp): o texto nunca é cortado — nem em
            baixo (altura fixa, era o bug do corte ao meio), nem pela largura
             (autoSize acha o tamanho que cabe em qualquer tela/escala) -->
        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/aston_script"
            android:gravity="center"
            android:text="@string/splash_welcome"
            android:textColor="@color/on_background"
            app:autoSizeMaxTextSize="56sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <ProgressBar
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="42dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />
    </LinearLayout>

    <!-- Versão SEMPRE no rodapé (v0.18.8, pedido do autor): o texto é
         preenchido no SplashActivity com o BuildConfig da build — nunca
         desatualiza. A assinatura "feito por micaelsan" agora mora ao lado
         do número da versão no rodapé do Início -->
    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:alpha="0"
        android:letterSpacing="0.06"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp" />
</FrameLayout>
