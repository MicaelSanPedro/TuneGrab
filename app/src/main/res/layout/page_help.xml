<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.9: página "Ajuda" das Configurações (estilo YouTube LITERAL) —
     reabre o tutorial de primeira abertura (v0.19.6). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowTutorial"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            style="@style/SettingsRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_play" />

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_tutorial_btn" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_tutorial_hint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
