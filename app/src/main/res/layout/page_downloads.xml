<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.9: página "Downloads" das Configurações (estilo YouTube LITERAL —
     aberta ao tocar na pasta da lista principal). IDs preservados do antigo
     fragment_settings.xml: binding só trocou o prefixo do include. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Pasta de download: subtítulo = pasta atual; toque abre o SAF -->
    <LinearLayout
        android:id="@+id/rowFolder"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            style="@style/SettingsRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder" />

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_folder" />

            <TextView
                android:id="@+id/tvFolderCurrent"
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_folder_default" />
        </LinearLayout>
    </LinearLayout>

    <!-- Só aparece com pasta personalizada ativa -->
    <LinearLayout
        android:id="@+id/rowFolderReset"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <ImageView
            style="@style/SettingsRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_refresh" />

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_reset_folder" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
