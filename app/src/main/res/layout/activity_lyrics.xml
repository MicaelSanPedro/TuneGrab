<?xml version="1.0" encoding="utf-8"?>
<!-- GERADOR DE LETRA (v0.22.7): tela da letra da faixa tocando — o mesmo
     preto do player, topo com voltar + nome da música, corpo em 3 estados
     (sincronizada / simples / mensagem) e crédito da fonte no pé -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="34dp">

        <!-- topo: voltar + nome da faixa (o tick atualiza quando a fila pula) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/lyrics_back"
                android:src="@drawable/ic_back"
                app:tint="@color/on_background" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_background"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- letra SINCRONIZADA: a linha do momento acende e a tela anda
                 sozinha (o usuário pode rolar pra reler — volta em 4s) -->
            <ScrollView
                android:id="@+id/svLyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="28dp" />
            </ScrollView>

            <!-- letra SIMPLES (sem marcação de tempo): texto inteiro -->
            <ScrollView
                android:id="@+id/svPlain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPlain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:paddingStart="28dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="16dp"
                    android:textColor="@color/on_background"
                    android:textSize="16sp" />
            </ScrollView>

            <!-- mensagens: não achou / sem internet / instrumental -->
            <LinearLayout
                android:id="@+id/stateBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_lyrics_pill"
                    android:paddingStart="22dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="10dp"
                    android:text="@string/lyrics_retry"
                    android:textColor="@color/on_background"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressLyrics"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/lyrics_searching"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0.55"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="@string/lyrics_credit"
        android:textColor="@color/on_surface_variant"
        android:textSize="10sp" />
</FrameLayout>
