        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rV720"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 480p -->
    <LinearLayout
        android:id="@+id/rowV480"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_video_480" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_sub_480" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rV480"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 360p -->
    <LinearLayout
        android:id="@+id/rowV360"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_video_360" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_sub_360" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rV360"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Nota curta no rodapé (a explicação longa da v0.19.8 saiu) -->
    <TextView
        style="@style/SettingsRowSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:text="@string/set_video_note" />
</LinearLayout>
