<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.9: página "Vídeo" das Configurações (estilo YouTube LITERAL) —
     qualidade padrão do seletor como linha que abre diálogo de escolha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowVideo"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            style="@style/SettingsRowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_movie" />

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_row_video" />

            <TextView
                android:id="@+id/tvVideoSub"
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
