<?xml version="1.0" encoding="utf-8"?>
<!-- v0.19.10: página "Vídeo" com a escada COMPLETA visível na tela
     (4K → 360p, igual à do seletor — antes eram só 4 numa diálogo).
     Toque escolhe e salva na hora, bolinha roxa marca a escolhida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SettingsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_row_video" />

    <!-- 4K -->
    <LinearLayout
        android:id="@+id/rowV2160"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_video_2160" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_sub_2160" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rV2160"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 1440p -->
    <LinearLayout
        android:id="@+id/rowV1440"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/SettingsRowTexts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                style="@style/SettingsRowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_video_1440" />

            <TextView
                style="@style/SettingsRowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/v_sub_1440" />
        </LinearLayout>

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rV1440"
            style="@style/SettingsRadio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 1080p -->
    <LinearLayout
        android:id="@+id/rowV1080"
        style="@style/SettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

