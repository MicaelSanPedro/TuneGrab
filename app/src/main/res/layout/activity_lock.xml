<?xml version="1.0" encoding="utf-8"?>
<!-- Trava de acesso (v0.20.0; v0.21.0 ganhou a caixa do CÓDIGO DESTE
     APARELHO — do ANDROID_ID, toque copia — pra pessoa mandar pro autor
     junto com o nome e ganhar senha presa nela). Mesmo idioma visual do
     Splash (logo + letreiro led "TuneGrab" em Poppins no tom primary), um
     campo, um botão. O status (erro/aceito) aparece entre o botão e o
     rodapé; o ScrollView existe pro teclado aberto não esmagar nada
     (adjustResize no manifest). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <!-- Letreiro led, o mesmo do Início e do rodapé do Splash — a
             identidade do app bater o olho antes de pedir qualquer coisa -->
        <com.tunegrab.app.ui.LedTextView
            android:id="@+id/txtLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/txtLockSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/lock_sub"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fieldPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:hint="@string/lock_hint"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeErrorColor="@color/state_failed"
            app:hintEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/lock_btn"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- CÓDIGO DESTE APARELHO (v0.21.0): a senha pode ser presa num
             aparelho só — é daqui que sai o código que a pessoa manda pro
             autor. Toque inteiro copia (LedTextView com a identidade, igual
             ao letreiro de cima). -->
        <LinearLayout
            android:id="@+id/deviceBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/txtDeviceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:text="@string/lock_device_label"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <com.tunegrab.app.ui.LedTextView
                android:id="@+id/txtDeviceCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.14"
                android:textColor="@color/primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtDeviceCopyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:text="@string/lock_device_copy_hint"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLockFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/lock_footer"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
